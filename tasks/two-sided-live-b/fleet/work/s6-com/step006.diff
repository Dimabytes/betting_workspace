+def test_unbooked_final_merge_keeps_the_hold_and_skips_cleanup(
+    tmp_path: Path, request: pytest.FixtureRequest, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    alerts = AlertRecorder()
+    monkeypatch.setattr(two_sided_worker, "notify_in_background", alerts)
+    sleeps, original_sleep = _record_backoff(monkeypatch)
+    holder: dict[str, Any] = {}
+
+    async def merge_all() -> None:
+        holder["calls"].append("merge_all")
+        raise MergeAccountingError(tx_hash="0xstuck", qty=10.0)
+
+    worker, store, calls, finished = _install_final_watch(tmp_path, request, monkeypatch, merge_all)
+    holder["calls"] = calls
+    store.hold_merge(token_ids=(YES_TOKEN, NO_TOKEN))
+
+    async def scenario() -> None:
+        task = asyncio.create_task(worker._quiesce(True))
+        while calls.count("merge_all") < 4:
+            await original_sleep(0)
+        task.cancel()
+        with pytest.raises(asyncio.CancelledError):
+            await task
+
+    asyncio.run(scenario())
+    assert calls.count("merge_all") == 4
+    assert "end_snapshot" not in calls
+    assert "zero" not in calls
+    assert "unregister" not in calls
+    assert finished == []
+    assert sleeps == _backoff_prefix(4)
+    assert store.merge_is_held(YES_TOKEN) is True
+    assert store.merge_is_held(NO_TOKEN) is True
+    assert len(alerts.messages) == 4
