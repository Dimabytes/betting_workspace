+def _record_backoff(monkeypatch: pytest.MonkeyPatch) -> tuple[list[float], Any]:
+    sleeps: list[float] = []
+    original_sleep = asyncio.sleep
+
+    async def recorded_sleep(delay: float) -> None:
+        sleeps.append(delay)
+        await original_sleep(0)
+
+    monkeypatch.setattr(two_sided_worker.asyncio, "sleep", recorded_sleep)
+    return sleeps, original_sleep
+
