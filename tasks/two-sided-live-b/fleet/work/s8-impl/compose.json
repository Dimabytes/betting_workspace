  "services": {
    "compress": {
      "build": {
        "context": "/Users/dimabytes/work/polymarket/dota_2_bot",
        "dockerfile": "esports-trader/Dockerfile"
      },
      "command": [
        "uv",
        "run",
        "--frozen",
        "--no-dev",
        "python",
        "-m",
        "trader.compress_archives",
        "--root",
        "/app/data/trader_live",
        "--root",
        "/app/data/trader_paper",
        "--root",
        "/app/data/trader_live_b"
      ],
      "init": true,
      "logging": {
        "driver": "local",
        "options": {
          "max-file": "5",
          "max-size": "10m"
        }
      },
      "networks": {
        "default": null
      },
      "restart": "unless-stopped",
      "stop_grace_period": "30s",
      "volumes": [
        {
          "bind": {
            "create_host_path": true
          },
          "source": "/Users/dimabytes/work/polymarket/dota_2_bot/esports-trader-s8/data/trader_live",
          "target": "/app/data/trader_live",
          "type": "bind"
