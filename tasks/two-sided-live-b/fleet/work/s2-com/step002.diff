+
+def _run(*, state: StrategyState, events: tuple[InboundEvent, ...]) -> list[EngineOutput]:
+    outputs: list[EngineOutput] = []
+    for event in events:
+        output = step(state=state, policy=POLICY, event=event)
+        outputs.append(output)
+        state = output.state
