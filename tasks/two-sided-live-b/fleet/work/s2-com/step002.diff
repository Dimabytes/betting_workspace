+        ),
+    )[-1]
+    assert {cancel.order_id: cancel.reason for cancel in moved.plan.cancels} == {
+        ids[0]: "reprice",
+        ids[1]: "reprice",
+    }
+    assert moved.plan.places == ()
+    assert moved.state.reprice_since_ns == (None, None)
