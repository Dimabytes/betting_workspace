+
+
+def _books(*, bid0: float, ask0: float, bid1: float, ask1: float, ts_ns: int) -> BookPair:
+    return BookPair(
+        tokens=(
+            TokenBook(
+                token_index=0, bid=bid0, ask=ask0, bid_size=100.0, ask_size=100.0, ts_ns=ts_ns
