--- /dev/null
+++ b/src/dashboard/game_oddin.py
@@ -0,0 +1,213 @@
+from collections.abc import Mapping
+from dataclasses import dataclass
+from typing import cast
+
+from shared.utils.json_read import as_map, read_str, try_int
+from shared.utils.match_time import parse_utc
+from trader.oddin_feed import (
+    RECONNECT_EVENT,
+    SNAPSHOT_EVENT,
+    WS_EVENT,
+    OddinSnapshotReducer,
+    project_tick,
+)
+from trader.oddin_types import DIRE, RADIANT
+from viewer.archive_read import as_str
+
+CONTROL_LIMIT = 8
+
+
+@dataclass(frozen=True)
+class OddinPlayerObs:
+    nick: str | None
+    hero: str | None
+    net_worth: int | None
+    kills: int | None
+    deaths: int | None
+    assists: int | None
+    alive: bool | None
+    respawn: int | None
+    aegis: bool | None
+
+
+@dataclass(frozen=True)
+class OddinSliceObs:
+    received_at_utc: str
+    updated_at: str | None
+    second: int | None
+    paused: bool | None
+    match_status: str | None
+    kills_0: int | None
+    kills_1: int | None
+    gold_0: int | None
+    gold_1: int | None
+    towers_0: int | None
+    towers_1: int | None
+    barracks_0: int | None
+    barracks_1: int | None
+    roshans_0: int | None
+    roshans_1: int | None
+    series_home: int | None
+    series_away: int | None
+    home_name: str | None
+    away_name: str | None
+    name_0: str | None
+    name_1: str | None
+    players_0: tuple[OddinPlayerObs, ...]
+    players_1: tuple[OddinPlayerObs, ...]
+
+
+def _faction_side(payload: Mapping[str, object], faction: str) -> dict[str, object] | None:
+    current = as_map(payload.get("currentMap"))
+    if current is None:
+        return None
+    for side_key in ("homeTeam", "awayTeam"):
+        side = as_map(current.get(side_key))
+        if side is None:
+            continue
+        if read_str(side, "faction").upper() == faction:
+            return side
+    return None
+
+
+def _team_gold(side: Mapping[str, object]) -> int | None:
+    gold = try_int(side.get("netWorthNullable"))
+    if gold is not None:
+        return gold
+    return try_int(side.get("netWorth"))
+
+
+def _team_barracks(side: Mapping[str, object]) -> int | None:
+    barracks = try_int(side.get("barracksNullable"))
+    if barracks is not None:
+        return barracks
+    return try_int(side.get("barracks"))
+
+
+def _side_players(side: Mapping[str, object], nicks: tuple[str, ...]) -> tuple[OddinPlayerObs, ...]:
+    raw_players = side.get("players")
+    rows: list[dict[str, object]] = []
+    if isinstance(raw_players, list):
+        rows = [
+            row
+            for row in (as_map(item) for item in cast(list[object], raw_players))
+            if row is not None
+        ]
+    out: list[OddinPlayerObs] = []
+    for nick in nicks:
+        row = next(
+            (
+                item
+                for item in rows
+                if read_str(as_map(item.get("player")) or {}, "nickname") == nick
+            ),
+            None,
+        )
+        if row is None:
+            out.append(OddinPlayerObs(nick, None, None, None, None, None, None, None, None))
+            continue
+        player = as_map(row.get("player")) or {}
+        hero = as_map(row.get("hero")) or {}
+        alive = row.get("alive")
+        aegis = row.get("hasAegis")
+        out.append(
+            OddinPlayerObs(
+                nick=read_str(player, "nickname") or None,
+                hero=read_str(hero, "name") or None,
+                net_worth=try_int(row.get("netWorth")),
+                kills=try_int(row.get("kills")),
+                deaths=try_int(row.get("deaths")),
+                assists=try_int(row.get("assists")),
+                alive=alive if isinstance(alive, bool) else None,
+                respawn=try_int(row.get("respawnTimer")),
+                aegis=aegis if isinstance(aegis, bool) else None,
+            )
+        )
+    return tuple(out)
+
+
+def _obs(payload: Mapping[str, object], received: str) -> OddinSliceObs | None:
+    tick = project_tick(payload)
+    if tick.radiant is None or tick.dire is None:
+        return None
+    raw_0 = _faction_side(payload, RADIANT)
+    raw_1 = _faction_side(payload, DIRE)
+    paused = payload.get("mapPaused")
+    return OddinSliceObs(
+        received_at_utc=received,
+        updated_at=tick.last_updated_at or None,
+        second=tick.game_time,
+        paused=paused if isinstance(paused, bool) else None,
+        match_status=tick.match_status if tick.match_status != "?" else None,
+        kills_0=try_int(raw_0.get("kills")) if raw_0 is not None else None,
+        kills_1=try_int(raw_1.get("kills")) if raw_1 is not None else None,
+        gold_0=_team_gold(raw_0) if raw_0 is not None else None,
+        gold_1=_team_gold(raw_1) if raw_1 is not None else None,
+        towers_0=try_int(raw_0.get("towers")) if raw_0 is not None else None,
+        towers_1=try_int(raw_1.get("towers")) if raw_1 is not None else None,
+        barracks_0=_team_barracks(raw_0) if raw_0 is not None else None,
+        barracks_1=_team_barracks(raw_1) if raw_1 is not None else None,
+        roshans_0=try_int(raw_0.get("roshans")) if raw_0 is not None else None,
+        roshans_1=try_int(raw_1.get("roshans")) if raw_1 is not None else None,
+        series_home=try_int(payload.get("homeScore")),
+        series_away=try_int(payload.get("awayScore")),
+        home_name=tick.home_name,
+        away_name=tick.away_name,
+        name_0=tick.radiant.name,
+        name_1=tick.dire.name,
+        players_0=_side_players(raw_0, tuple(p.nickname for p in tick.radiant.players))
+        if raw_0 is not None
+        else (),
+        players_1=_side_players(raw_1, tuple(p.nickname for p in tick.dire.players))
+        if raw_1 is not None
+        else (),
+    )
+
+
+class OddinFold:
+    def __init__(self, *, map_number: int, yes_is_radiant: bool) -> None:
+        self._reducer = OddinSnapshotReducer(map_number, yes_is_radiant)
+        self.last: OddinSliceObs | None = None
+        self.terminal = False
+        self.rejected = 0
+        self.control: tuple[str, ...] = ()
+
+    def _note(self, text: str) -> None:
+        self.control = (*self.control, text)[-CONTROL_LIMIT:]
+
+    def apply(self, record: Mapping[str, object]) -> None:
+        event_name = as_str(record.get("event"))
+        received = as_str(record.get("received_at_utc"))
+        if event_name == SNAPSHOT_EVENT:
+            self._note(f"seed @{received}")
+            return
+        if event_name == RECONNECT_EVENT:
+            self._reducer.reset()
+            self._note(f"reconnect @{received}")
+            return
+        if event_name != WS_EVENT:
+            self.rejected += 1
+            self._note(f"unknown event {event_name!r}")
+            return
+        if self.terminal:
+            return
+        payload = as_map(record.get("payload"))
+        if payload is None or received is None:
+            self.rejected += 1
+            self._note("malformed ws record")
+            return
+        try:
+            received_dt = parse_utc(received)
+        except ValueError:
+            self.rejected += 1
+            self._note("bad receipt stamp")
+            return
+        event = self._reducer.apply_payload(payload, received_dt)
+        if event is None:
+            self.rejected += 1
+            return
+        if event.snapshot.finished:
+            self.terminal = True
+            self._note(f"terminal @{received}")
+            return
+        self.last = _obs(payload, received)
