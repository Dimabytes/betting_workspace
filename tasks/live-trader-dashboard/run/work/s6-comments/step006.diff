+
+LADDER_LEVELS = 5
+WALLET_STALE_S = 15.0
+TRANSITIONAL_STATUSES = frozenset({"pending", "canceling", "unknown"})
+LIVE_OVERLAY_STATUSES = frozenset({"live"})
+
+
+@dataclass(frozen=True)
+class SideFacts:
