+import html
+
+import streamlit as st
+
+from dashboard.fresh_view import render_fresh
+from dashboard.game_types import GameSummary, Objectives, PlayerSummary, SideSlice
+from dashboard.home import fmt_age, fmt_second, fmt_usd
+from dashboard.home_diag import Diagnostic, DiagnosticsView
+from dashboard.match_history import EventRow
+from dashboard.match_state import BookPanel, LadderRow, MatchState, PositionBlock
+
+_SEVERITY_TEXT = {"fatal": "FATAL", "error": "ОШИБКА", "warn": "ВНИМ", "info": "инфо"}
+
+_SIDE_CLASS = {"Radiant": "side0", "Blue": "side0", "Dire": "side1", "Red": "side1"}
+
+_CSS = """
+.mp { font-variant-numeric: tabular-nums; font-size: 0.82rem; line-height: 1.35; }
+.mp-table { border-collapse: collapse; width: 100%; }
+.mp-table td, .mp-table th {
+  padding: 0.05rem 0.35rem; text-align: right; white-space: nowrap;
+  overflow: hidden; text-overflow: ellipsis; max-width: 8rem;
+}
+.mp-table th { color: #8B98A5; font-weight: normal; text-align: right; }
+.mp-table td.name { text-align: left; }
+.mp-side0 { color: #4F9D7E; }
+.mp-side1 { color: #C05B5B; }
+.mp-own { color: #E3A93B; }
+.mp-own-row td { background: rgba(227, 169, 59, 0.14); }
+.mp-muted { color: #8B98A5; }
+.mp-book-head { color: #8B98A5; padding: 0.1rem 0 0.2rem; }
+"""
+
+
+def _esc(value: object) -> str:
+    return html.escape("" if value is None else str(value))
+
+
+def _qty(value: float | None) -> str:
+    return "—" if value is None else f"{value:g}"
+
+
+def _price(value: float | None) -> str:
+    return "—" if value is None else f"{value:g}"
+
+
+def render_header(state: MatchState, diag: DiagnosticsView) -> None:
+    cols = st.columns([6, 1, 1])
+    with cols[0]:
+        st.markdown(f"### {_esc(state.title)}")
+    with cols[1]:
+        st.link_button("← главная", "/", use_container_width=True)
+    with cols[2]:
+        if state.poly_url is not None:
+            st.link_button("polymarket", state.poly_url, use_container_width=True)
+    status = state.map_status
+    st.caption(f"{_esc(state.sides_line)} · статус {status}")
+    if state.orientation_note:
+        st.caption(f"⚠ {_esc(state.orientation_note)}")
+    for note in state.notes:
+        st.caption(f"⚠ {_esc(note)}")
+    st.caption(f"диагностика: {_esc(diag.line)}")
+    if diag.findings:
+        exp = st.expander(f"Диагностика ({len(diag.findings)})", on_change="rerun", key="mp-diag")
+        if exp.open:
+            with exp:
+                for finding in diag.findings:
+                    _finding_block(finding)
+
+
+def _finding_block(finding: Diagnostic) -> None:
+    age = fmt_age(finding.ts) if finding.ts is not None else "время ?"
+    st.write(f"**{_SEVERITY_TEXT[finding.severity]}** · {_esc(finding.label)}")
+    st.caption(f"{_esc(finding.source)} · {age} назад")
+    for detail in finding.details:
+        st.write(f"· {_esc(detail)}")
+
+
+def render_now(state: MatchState) -> None:
+    line = f"сейчас: {state.now.position_line}"
+    if state.now.sell_detail:
+        line += f" · {state.now.sell_line} ({state.now.sell_detail})"
+    else:
+        line += f" · {state.now.sell_line}"
+    if state.now.wedge:
+        st.warning(_esc(line))
+    else:
+        st.markdown(f"**{_esc(line)}**")
+
+
+def render_buy(state: MatchState) -> None:
+    buy = state.buy
+    age = fmt_age(buy.decision_age_s) if buy.decision_age_s is not None else "возраст ?"
+    st.markdown(f"**не покупаем:** {_esc(buy.reason)} · {_esc(buy.block)}")
+    st.caption(
+        f"{_esc(buy.delta_text)}"
+        + (f" · {_esc(buy.threshold_text)}" if buy.threshold_text else "")
+        + f" · решение {age} назад"
+    )
+    if buy.window_text:
+        st.caption(_esc(buy.window_text))
+    st.caption(_esc(buy.map_limit))
+    if buy.map_details:
+        st.caption(" · ".join(_esc(detail) for detail in buy.map_details))
+
+
+def render_ages(state: MatchState) -> None:
+    for line in state.ages:
+        age = fmt_age(line.age_s) if line.age_s is not None else "точное время неизвестно"
+        suffix = f" · {_esc(line.suffix)}" if line.suffix else ""
+        st.caption(f"{_esc(line.label)}: {age}{suffix}")
+
+
+def _objectives_rows(objectives: Objectives | None) -> str:
+    if objectives is None:
+        return "<span class='mp-muted'>нет данных</span>"
+    towers = float(objectives.towers) if objectives.towers is not None else None
+    barracks = float(objectives.barracks) if objectives.barracks is not None else None
+    roshans = float(objectives.roshans) if objectives.roshans is not None else None
+    return f"башни {_qty(towers)} · бараки {_qty(barracks)} · рошаны {_qty(roshans)}"
+
+
+def _players_html(players: tuple[PlayerSummary, ...]) -> str:
+    rows: list[str] = []
+    rows.append("<tr><th class='name'>игрок</th><th>герой</th><th>NW</th><th>K/D/A</th></tr>")
+    if not players:
+        rows.append("<tr><td class='name mp-muted' colspan='4'>нет данных</td></tr>")
+    for player in players:
+        nick = player.nick or player.nick_compact or "?"
+        hero = player.hero or player.hero_compact or "—"
+        kills = float(player.kills) if player.kills is not None else None
+        deaths = float(player.deaths) if player.deaths is not None else None
+        assists = float(player.assists) if player.assists is not None else None
+        net_worth = float(player.net_worth) if player.net_worth is not None else None
+        kda = f"{_qty(kills)}/{_qty(deaths)}/{_qty(assists)}"
+        cls = "" if player.alive is not False else " class='mp-muted'"
+        title = _esc(f"{player.nick or ''} · {player.hero or ''}")
+        rows.append(
+            f"<tr{cls} title='{title}'>"
+            f"<td class='name'>{_esc(player.nick_compact or nick)}</td>"
+            f"<td>{_esc(player.hero_compact or hero)}</td>"
+            f"<td>{_qty(net_worth)}</td>"
+            f"<td>{kda}</td></tr>"
+        )
+    return f"<table class='mp-table'>{''.join(rows)}</table>"
+
+
+def _side_block(side: SideSlice, objectives: Objectives | None, objectives_key: str) -> None:
+    cls = _SIDE_CLASS.get(side.label, "")
+    team = side.team_name or "—"
+    gold = _qty(float(side.gold) if side.gold is not None else None)
+    deaths = _qty(float(side.players_deaths) if side.players_deaths is not None else None)
+    st.markdown(
+        f"<div class='mp'><span class='mp-{cls or 'muted'}'>"
+        f"<b>{_esc(side.label)}</b> {_esc(team)}</span> "
+        f"<span class='mp-muted'>gold {gold} · смерти {deaths}</span></div>",
+        unsafe_allow_html=True,
+    )
+    st.markdown(f"<div class='mp'>{_players_html(side.players)}</div>", unsafe_allow_html=True)
+    exp = st.expander("объекты", on_change="rerun", key=objectives_key)
+    if exp.open:
+        with exp:
+            st.markdown(
+                f"<div class='mp'>{_objectives_rows(objectives)}</div>",
+                unsafe_allow_html=True,
+            )
+
+
+def _summary_parts(summary: GameSummary) -> list[str]:
+    decision = summary.decision
+    board = summary.board
+    second = float(decision.second) if decision.second is not None else None
+    parts = [f"t={fmt_second(second)}"]
+    if decision.phase:
+        parts.append(decision.phase)
+    if decision.paused:
+        parts.append("пауза")
+    if board is not None and board.kills_0 is not None and board.kills_1 is not None:
+        parts.append(f"убийства {board.kills_0}:{board.kills_1}")
+    if decision.radiant_nw_adv is not None:
+        parts.append(f"NW adv {decision.radiant_nw_adv:+d}")
+    if decision.xp_status == "not_used":
+        parts.append("XP не используется этой моделью")
+    elif decision.radiant_xp_adv is not None:
+        parts.append(f"XP adv {decision.radiant_xp_adv:+d}")
+    if board is not None and board.series is not None:
+        series = board.series
+        if series.score_0 is not None and series.score_1 is not None:
+            parts.append(f"серия {series.score_0}:{series.score_1}")
+    return parts
+
+
+def render_game(summary: GameSummary | None, key_prefix: str) -> None:
+    if summary is None:
+        st.caption("сводка игры недоступна — архив не читается")
+        return
+    st.markdown(" · ".join(_esc(part) for part in _summary_parts(summary)))
+    st.caption(f"{_esc(summary.decision_label)} · {_esc(summary.archive_label)}")
+    table = summary.table
+    if table is None or (not table.side_0.players and not table.side_1.players):
+        st.caption("игроки: нет данных")
+        if table is None:
+            return
+    cols = st.columns(2)
+    with cols[0]:
+        _side_block(table.side_0, table.objectives_0, f"{key_prefix}-obj0")
+    with cols[1]:
+        _side_block(table.side_1, table.objectives_1, f"{key_prefix}-obj1")
+
+
+def render_position(state: MatchState) -> None:
+    position: PositionBlock = state.position
+    st.markdown("**позиция**")
+    if not position.wallet_ok:
+        st.caption("live.db не читался — позиция неизвестна")
+        return
+    rows: list[str] = []
+    for leg in position.legs:
+        if leg.size is None and leg.held_qty in (None, 0.0):
+            continue
+        mark = f"{leg.mark:g}" if leg.mark is not None else "—"
+        side_cls = _SIDE_CLASS.get(leg.side_label or "", "muted")
+        rows.append(
+            f"<tr><td class='name mp-{side_cls}'><b>{_esc(leg.side)}</b> {_esc(leg.team or '')}</td>"
+            f"<td>{_qty(leg.size)}</td>"
+            f"<td>{_price(leg.avg_price)}</td>"
+            f"<td title='{_esc(leg.mark_state)}'>{mark}</td>"
+            f"<td>{_esc(fmt_usd(leg.unrealized, signed=True))}</td></tr>"
+        )
+    if rows:
+        st.markdown(
+            "<div class='mp'><table class='mp-table'>"
+            "<tr><th class='name'>исход</th><th>размер</th><th>ср.</th>"
+            "<th>марка</th><th>uPnL</th></tr>"
+            f"{''.join(rows)}</table></div>",
+            unsafe_allow_html=True,
+        )
+    else:
+        st.caption("нет позиции")
+    st.caption(
+        f"realized карты: {_esc(position.realized_text)} · rebate: {_esc(position.rebate_text)}"
+        + (f" · net: {_esc(position.net_text)}" if position.net_text else "")
+    )
+
+
+def _ladder_rows(rows: tuple[LadderRow, ...], *, empty: str) -> str:
+    if not rows:
+        return f"<tr><td class='mp-muted' colspan='3'>{empty}</td></tr>"
+    out: list[str] = []
+    for row in rows:
+        own = ""
+        cls = ""
+        if row.own_qty > 0.0:
+            own = f"наши {row.own_qty:g}"
+            cls = " class='mp-own-row'"
+        title = _esc(row.own_note) if row.own_note else ""
+        out.append(
+            f"<tr{cls} title='{title}'><td>{_price(row.price)}</td>"
+            f"<td>{_qty(row.size)}</td><td class='mp-own'>{_esc(own)}</td></tr>"
+        )
+    return "".join(out)
+
+
+def render_book(panel: BookPanel, key: str) -> None:
+    st.markdown(f"**{_esc(panel.label)}**")
+    age = fmt_age(panel.change_age_s) if panel.change_age_s is not None else "возраст ?"
+    fresh_state = (
+        "fresh"
+        if panel.state == "live"
+        else ("stale" if panel.state == "socket отключён" else "updating")
+    )
+    render_fresh(key, f"{panel.state} · изм. {age} назад", fresh_state, None)
+    asks = _ladder_rows(panel.asks, empty="asks пусто")
+    bids = _ladder_rows(panel.bids, empty="bids пусто")
+    extra = ""
+    if panel.own_extra:
+        extra_rows = "".join(
+            f"<tr class='mp-own-row'><td>{_price(row.price)}</td>"
+            f"<td class='mp-muted'>вне уровней</td>"
+            f"<td class='mp-own'>{_esc(row.own_note)}</td></tr>"
+            for row in panel.own_extra
+        )
+        extra = f"<tr><td class='mp-muted' colspan='3'>—</td></tr>{extra_rows}"
+    st.markdown(
+        "<div class='mp'>"
+        "<div class='mp-book-head'>ask ↑</div>"
+        f"<table class='mp-table'>{asks}</table>"
+        "<div class='mp-book-head'>bid ↓</div>"
+        f"<table class='mp-table'>{bids}{extra}</table></div>",
+        unsafe_allow_html=True,
+    )
+    if panel.note:
+        st.caption(_esc(panel.note))
+    if panel.stale_orders:
+        st.caption("наши ордера — последнее известное состояние checkpoint")
+
+
+def render_orders(state: MatchState, key: str) -> None:
+    transitional = [order for order in state.orders if order.transitional]
+    if transitional:
+        st.markdown("**ожидающие ордера**")
+        for order in transitional:
+            age = f"{order.observed_s:.0f}с" if order.observed_s is not None else "время ?"
+            st.caption(
+                f"{_esc(order.side)} {_esc(order.token_label)} {_qty(order.remaining)} "
+                f"@{_price(order.price)} · {_esc(order.status)} {age}"
+            )
+    exp = st.expander(f"все ордера ({len(state.orders)})", on_change="rerun", key=key)
+    if not exp.open:
+        return
+    with exp:
+        if not state.orders:
+            st.caption("ордеров нет")
+            return
+        rows: list[str] = []
+        for order in state.orders:
+            observed = f"{order.observed_s:.0f}с" if order.observed_s is not None else "—"
+            venue = order.venue or "—"
+            reason = order.reason or ""
+            conflict = " ⚠binding" if order.binding_conflict else ""
+            rows.append(
+                f"<tr title='{_esc(order.session_id)}'>"
+                f"<td class='name'>{_esc(order.order_id)}</td>"
+                f"<td>{_esc(order.side)}</td>"
+                f"<td>{_esc(order.token_label)}</td>"
+                f"<td>{_price(order.price)}</td>"
+                f"<td>{_qty(order.remaining)}</td>"
+                f"<td>{_esc(order.status)}{_esc(conflict)}</td>"
+                f"<td>{_esc(observed)}</td>"
+                f"<td>{_esc(venue)}</td>"
+                f"<td>{_esc(reason)}</td></tr>"
+            )
+        st.markdown(
+            "<div class='mp'><table class='mp-table'>"
+            "<tr><th class='name'>ордер</th><th>side</th><th>токен</th><th>цена</th>"
+            "<th>остаток</th><th>статус</th><th>наблюд.</th><th>venue</th><th>причина</th></tr>"
+            f"{''.join(rows)}</table></div>",
+            unsafe_allow_html=True,
+        )
+
+
+def render_details(state: MatchState, key: str) -> None:
+    exp = st.expander("детали", on_change="rerun", key=key)
+    if not exp.open:
+        return
+    with exp:
+        for line in state.details:
+            st.caption(_esc(line))
+
+
+def inject_css() -> None:
+    st.markdown(f"<style>{_CSS}</style>", unsafe_allow_html=True)
+
+
+def render_chart_unavailable(message: str) -> None:
+    st.caption(f"график недоступен: {_esc(message)}")
+
+
+def render_events(rows: tuple[EventRow, ...], truncated: bool, error: str | None) -> None:
+    if error is not None:
+        st.caption(f"лента недоступна: {_esc(error)}")
+        return
+    if not rows:
+        st.caption("событий нет")
+        return
+    for row in rows:
+        second = fmt_second(row.second) if row.second is not None else "—"
+        age = fmt_age(row.stamp_age_s) if row.stamp_age_s is not None else "время ?"
+        prefix = "начальное состояние · " if row.initial else ""
+        st.caption(f"{prefix}{_esc(row.label)} {second} · {age} назад · {_esc(row.text)}")
+    if truncated:
+        st.caption("показан ограниченный хвост журнала — полная история по запросу")
