+    details.extend(health_facts.evidence)
+    if not health_facts.ok:
+        return HealthLine("unknown", "состояние трейдера неизвестно", tuple(details))
+    if not health_facts.consistent:
+        return HealthLine("unknown", "контейнер сменился во время чтения", tuple(details))
+    if health_facts.container_id is None:
+        return HealthLine("error", "контейнер трейдера не найден", tuple(details))
+    if health_facts.container_state != "running":
+        return HealthLine(
+            "error",
+            f"контейнер {health_facts.container_state or 'неизвестно'}",
+            tuple(details),
+        )
+    if health_facts.halted:
+        return HealthLine(
+            "error",
+            f"HALT {health_facts.halt_label or 'risk_halt'}",
+            tuple(details),
+        )
+    if health_facts.halted is None:
