@@ -0,0 +1,252 @@
+"""Streamlit rendering for the home screen; consumes pure home DTOs."""
+
+from collections.abc import Callable
+from typing import Any, cast
+
+import streamlit as st
+from streamlit.delta_generator import DeltaGenerator
+
+from dashboard import home
+from dashboard.fresh_view import render_fresh
+from dashboard.home import (
+    ActiveRow,
+    ClosedRow,
+    Diagnostic,
+    DiagnosticsView,
+    FreshMetric,
+    HealthLine,
+    IdleRow,
+    ListsView,
+    ResidualRow,
+    StripView,
+)
+
+_SEVERITY_TEXT = {"fatal": "FATAL", "error": "ОШИБКА", "warn": "ВНИМ", "info": "инфо"}
+
+# streamlit dataframe overloads leak Unknown into strict basedpyright.
+_dataframe: Callable[..., DeltaGenerator] = cast(Any, st).dataframe
+
+
+def _metric(key: str, metric: FreshMetric) -> None:
+    st.caption(metric.title)
+    note = metric.note if metric.note is not None else metric.verdict.label
+    if metric.note is not None:
+        note = f"{metric.verdict.label} · {metric.note}"
+    render_fresh(key, metric.text, metric.verdict.state, note)
+    with st.popover("детали"):
+        if metric.verdict.age_s is not None:
+            st.caption(f"данные {home.fmt_age(metric.verdict.age_s)} назад")
+        for line in metric.details:
+            st.write(f"· {line}")
+
+
+def _health(health_facts: HealthLine) -> None:
+    st.caption("Трейдер")
+    st.markdown(f"**{health_facts.text}**")
+    with st.popover("детали"):
+        for line in health_facts.details:
+            st.write(f"· {line}")
+
+
+def render_strip(strip: StripView) -> None:
+    cols = st.columns(5)
+    with cols[0]:
+        _metric("cash", strip.collateral)
+    with cols[1]:
+        _metric("available", strip.available)
+    with cols[2]:
+        _metric("pnl", strip.pnl)
+    with cols[3]:
+        _metric("rebate", strip.rebate)
+    with cols[4]:
+        _health(strip.health)
+
+
+def _finding_block(finding: Diagnostic) -> None:
+    age = home.fmt_age(finding.ts) if finding.ts is not None else "время ?"
+    st.write(f"**{_SEVERITY_TEXT[finding.severity]}** · {finding.label}")
+    st.caption(f"{finding.source} · {age} назад")
+    for detail in finding.details:
+        st.write(f"· {detail}")
+
+
+def render_diagnostics(view: DiagnosticsView) -> None:
+    st.caption(f"диагностика: {view.line}")
+    if not view.findings:
+        return
+    with st.expander(f"Диагностика ({len(view.findings)})"):
+        for finding in view.findings:
+            _finding_block(finding)
+            st.divider()
+
+
+def _links(match_url: str | None, polymarket_url: str | None) -> None:
+    cols = st.columns(2)
+    if match_url is not None:
+        cols[0].link_button("карта", match_url)
+    if polymarket_url is not None:
+        cols[1].link_button("polymarket", polymarket_url)
+
+
+def _active_label(row: ActiveRow) -> str:
+    bits = [
+        row.title,
+        f"t={home.fmt_second(row.second)}",
+        row.phase or "?",
+        f"uPnL {home.fmt_usd(row.unrealized_total, signed=True)}",
+        row.reason,
+    ]
+    if row.paused:
+        bits.append("пауза")
+    if row.stale:
+        bits.append("устарело")
+    return " · ".join(bits)
+
+
+def _active_block(row: ActiveRow) -> None:
+    st.caption(
+        f"{row.game or '?'} · {row.window or 'окно неизвестно'}"
+        f" · решение {home.fmt_age(row.decision_age_s)} назад"
+        f" · фид {home.fmt_age(row.feed_age_s)} назад"
+    )
+    if row.position_state == "unknown":
+        st.write("позиция: кошелёк не читался — неизвестно")
+    elif row.position_state == "empty":
+        st.write("позиция: нет")
+    else:
+        _dataframe(
+            [
+                {
+                    "исход": leg.outcome,
+                    "размер": f"{leg.size:g}",
+                    "ср.": f"{leg.avg_price:g}",
+                    "марка": f"{leg.mark:g}" if leg.mark is not None else "—",
+                    "источник": leg.mark_state,
+                    "uPnL": home.fmt_usd(leg.unrealized, signed=True),
+                }
+                for leg in row.positions
+            ],
+            hide_index=True,
+        )
+    for line in row.state_lines:
+        st.write(f"· {line}")
+    with st.popover("evidence"):
+        for line in row.details:
+            st.write(f"· {line}")
+    _links(row.match_url, row.polymarket_url)
+
+
+def _idle_block(row: IdleRow) -> None:
+    st.caption(
+        f"{row.game or '?'} · источник {row.reason_source or row.source}"
+        f" · {home.fmt_age(row.reason_age_s)} назад"
+    )
+    for line in row.details:
+        st.write(f"· {line}")
+    _links(row.match_url, row.polymarket_url)
+
+
+def _closed_block(rows: tuple[ClosedRow, ...]) -> None:
+    _dataframe(
+        [
+            {
+                "карта": row.title,
+                "игра": row.game or "?",
+                "net": home.fmt_usd(row.net, signed=True),
+                "realized": home.fmt_usd(row.realized, signed=True),
+                "imv": home.fmt_usd(row.imv, signed=True),
+                "rebate": home.fmt_usd(row.rebate, signed=True),
+                "fills": row.fill_count if row.fill_count is not None else "—",
+                "замечена": (
+                    home.fmt_age(row.closed_age_s)
+                    if row.closed_age_s is not None
+                    else "дата неизвестна"
+                ),
+                "ссылка": row.match_url,
+            }
+            for row in rows
+        ],
+        hide_index=True,
+        column_config={
+            "карта": st.column_config.TextColumn(width="large"),
+            "ссылка": st.column_config.LinkColumn("карта", display_text="открыть"),
+        },
+    )
+
+
+def _residual_block(row: ResidualRow) -> None:
+    st.caption(f"{row.redeem_state} · positions {row.positions_state}")
+    if row.legs:
+        _dataframe(
+            [
+                {
+                    "исход": leg.outcome,
+                    "API": f"{leg.api_size:g}" if leg.api_size is not None else "—",
+                    "локально": (f"{leg.local_size:g}" if leg.local_size is not None else "—"),
+                    "ср.": f"{leg.local_avg:g}" if leg.local_avg is not None else "—",
+                    "марка": f"{leg.mark:g}" if leg.mark is not None else "—",
+                    "источник": leg.mark_state,
+                    "оценка": home.fmt_usd(leg.value),
+                }
+                for leg in row.legs
+            ],
+            hide_index=True,
+        )
+    for line in row.commitments:
+        bits = [
+            f"{line.source}",
+            f"qty {line.qty:g}" if line.qty is not None else "qty ?",
+            f"резерв {home.fmt_usd(line.remaining_notional)}",
+            line.status,
+        ]
+        if line.age_s is not None:
+            bits.append(f"возраст {home.fmt_age(line.age_s)}")
+        ids = " · ".join(
+            part
+            for part in (
+                line.venue_id,
+                line.core_order_id,
+                line.token_id,
+            )
+            if part
+        )
+        st.write(" · ".join(bits))
+        st.caption(ids or "—")
+    for line in row.details:
+        st.write(f"· {line}")
+    _links(row.match_url, row.polymarket_url)
+
+
+def render_lists(view: ListsView) -> None:
+    st.subheader("Торгуем сейчас")
+    if not view.active:
+        st.caption("нет активных карт")
+    for row in view.active:
+        with st.expander(_active_label(row)):
+            _active_block(row)
+
+    st.subheader("Скоро / не торгуем")
+    if view.nontrading_note is not None:
+        st.caption(f"сканирование: {view.nontrading_note}")
+    if not view.idle:
+        st.caption("нет наблюдаемых не-торговых рынков")
+    for row in view.idle:
+        with st.expander(f"{row.title} — {row.reason}"):
+            _idle_block(row)
+
+    st.subheader("Закрытые сегодня")
+    if not view.closed_dated:
+        st.caption("сегодня карты не закрывались")
+    else:
+        _closed_block(view.closed_dated)
+    if view.closed_undated:
+        with st.expander(f"Завершённые без даты закрытия ({len(view.closed_undated)})"):
+            st.caption("момент закрытия неизвестен — в «сегодня» не входят")
+            _closed_block(view.closed_undated)
+
+    st.subheader("Остатки завершённых карт")
+    if not view.residuals:
+        st.caption("открытых остатков нет")
+    for row in view.residuals:
+        with st.expander(f"{row.title} — {row.redeem_state}"):
+            _residual_block(row)
