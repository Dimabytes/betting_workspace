+"""Read-only Streamlit home screen over the process-wide LiveHub."""
+
+import sys
+import time
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+import streamlit as st
+
+from dashboard import home
+from dashboard.home import (
+    SellWatcher,
+    build_diagnostics,
+    build_lists,
+    build_strip,
+    find_match,
+)
+from dashboard.home_view import render_diagnostics, render_lists, render_strip
+from dashboard.live_hub import LiveHub, get_live_hub
+
+if __name__ == "__main__":
+    st.set_page_config(page_title="esports-trader", layout="wide")
+
+
+@st.cache_resource(on_release=lambda hub: hub.close())
+def _hub() -> LiveHub:
+    return get_live_hub()
+
+
+@st.cache_resource
+def _sell_watcher() -> SellWatcher:
+    return SellWatcher()
+
+
+@st.fragment(run_every=1)
+def _fast() -> None:
+    snap = _hub().get_snapshot()
+    now_s = time.time()
+    render_strip(build_strip(snap, now_s))
+    render_diagnostics(build_diagnostics(snap, _sell_watcher(), now_s))
+
+
+@st.fragment(run_every=60)
+def _lists() -> None:
+    snap = _hub().get_snapshot()
+    render_lists(build_lists(snap, time.time()))
+
+
+def _match_page(match_id: str) -> None:
+    snap = _hub().get_snapshot()
+    matches = find_match(snap, match_id)
+    if len(matches) == 1:
+        st.title(home.map_title(matches[0].entry))
+        st.caption(f"match {match_id} · детальный экран — следующий шаг разработки")
+    elif matches:
+        st.title(match_id)
+        st.warning("несколько архивов с этим match id — выбор неоднозначен")
+    else:
+        st.title(match_id)
+        st.warning("карта не найдена в каталоге")
+    st.link_button("← на главную", "/")
+
+
+if __name__ == "__main__":
+    _match = st.query_params.get("match")
+    if _match:
+        _match_page(_match)
+    else:
+        _fast()
+        _lists()
